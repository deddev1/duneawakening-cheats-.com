---
import type { PageId } from '../data/i18n/content.generated';

interface Props {
	pageId?: PageId;
}

const { pageId } = Astro.props;
---

<div
	class="wingman"
	data-wingman
	data-page-id={pageId ?? ''}
	aria-live="polite"
	hidden
>
	<div class="wingman__stage">
		<div class="wingman__brand" data-wingman-brand>
			<img
				class="wingman__logo"
				src="/images/dune-awakening-logo.webp"
				alt="Dune Awakening logo"
				width="320"
				height="120"
				loading="lazy"
				decoding="async"
				fetchpriority="low"
			/>
		</div>
	</div>
</div>
